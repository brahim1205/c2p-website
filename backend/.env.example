NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://postgres:postgres@db:5432/kodify?schema=public
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
PRISMA_CONNECTION_REQUIRED=false
PRISMA_PLATFORM_SYNC_ENABLED=true
PRISMA_PLATFORM_SYNC_ON_BOOT=true
PRISMA_PLATFORM_SEED_ENABLED=false
# compat = legacy complet, read-only = bloque POST/PATCH/DELETE, disabled = coupe /data.
DATA_LEGACY_API_MODE=compat
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=45
GLOBAL_RATE_LIMIT_MAX=180
FINANCE_RATE_LIMIT_MAX=90
PROVIDER_WEBHOOK_RATE_LIMIT_MAX=120
SESSION_COOKIE_NAME=c2p_at
REFRESH_COOKIE_NAME=c2p_rt
CSRF_COOKIE_NAME=c2p_csrf
FRONTEND_MONITORING_ENABLED=true
ENABLE_METRICS=true
METRICS_AUTH_TOKEN=replace-with-strong-metrics-token
EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=10000
RESEND_API_KEY=
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
OAUTH_CALLBACK_BASE_URL=http://localhost:3003/api
OAUTH_STATE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
C2P_SUPERADMIN_EMAIL=superadmin@c2p.sn
C2P_SUPERADMIN_PASSWORD=
C2P_SUPERADMIN_PASSWORD_HASH=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DISABLED=true
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
SMS_PROVIDER=mock
SMS_SENDER_ID=C2P
SMS_TEST_RECIPIENT=
# Utiliser SMS_PROVIDER=brevo pour envoyer via Brevo avec BREVO_API_KEY.
SENDTEXT_BASE_URL=https://backend.sendtext.sn
SENDTEXT_SEND_PATH=
SENDTEXT_API_KEY=
SENDTEXT_API_SECRET=
SENDTEXT_TIMEOUT_MS=10000
# Docker local cible MinIO via backend/docker-compose.yml. Hors Docker, local-disk reste utilisable.
UPLOAD_STORAGE_DRIVER=local-disk
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_STORAGE_ROOT=storage/uploads
UPLOAD_TMP_ROOT=storage/uploads/_tmp
UPLOAD_TMP_MAX_AGE_HOURS=24
UPLOAD_S3_ENDPOINT=http://minio:9000
UPLOAD_S3_REGION=us-east-1
UPLOAD_S3_BUCKET=c2p-uploads
UPLOAD_S3_ACCESS_KEY_ID=c2p-minio
UPLOAD_S3_SECRET_ACCESS_KEY=c2p-minio-password
UPLOAD_S3_KEY_PREFIX=uploads
UPLOAD_S3_FORCE_PATH_STYLE=true
UPLOAD_IMAGE_MAX_MB=8
UPLOAD_RAW_MAX_MB=512
UPLOAD_VIDEO_MAX_MB=5120
UPLOAD_REQUEST_MAX_MB=5120
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=c2p
DEXPAY_ENABLED=false
DEXPAY_BASE_URL=
DEXPAY_API_KEY=
DEXPAY_API_SECRET=
DEXPAY_TIMEOUT_MS=12000
DEXPAY_WEBHOOK_SECRET=
DEXPAY_WEBHOOK_SIGNATURE_HEADER=x-dexpay-signature
DEXPAY_DEFAULT_ASSET=DUSD
DEXPAY_DEFAULT_CHAIN=BSC
DEXPAY_ONRAMP_TYPE=BUY
DEXPAY_OFFRAMP_TYPE=SELL
