{
  "name": "kodify-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "NODE_OPTIONS='--experimental-specifier-resolution=node' node --loader ts-node/esm src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "security:test": "node scripts/security-check.mjs",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/client": "^5.15.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.19",
    "@types/node": "^20.14.7",
    "prisma": "^5.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
