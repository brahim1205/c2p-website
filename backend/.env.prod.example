# Production template for the backend runtime.
# Keep real values only on the target host or in the CI/CD secret store.

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-db?schema=public

# Public frontend origins allowed to call the API.
# APP_ORIGINS is the canonical variable used by this project.
# CORS_ORIGIN is also accepted as a compatibility alias.
APP_ORIGINS=https://c2p.sn,https://www.c2p.sn
# CORS_ORIGIN=https://c2p.sn,https://www.c2p.sn

COOKIE_DOMAIN=.c2p.sn
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY=true
PRISMA_PLATFORM_SYNC_ENABLED=true
PRISMA_PLATFORM_SYNC_ON_BOOT=true

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=15
GLOBAL_RATE_LIMIT_MAX=180
FINANCE_RATE_LIMIT_MAX=45
PROVIDER_WEBHOOK_RATE_LIMIT_MAX=180
SESSION_COOKIE_NAME=c2p_at
REFRESH_COOKIE_NAME=c2p_rt
CSRF_COOKIE_NAME=c2p_csrf

FRONTEND_MONITORING_ENABLED=true
ENABLE_METRICS=true
METRICS_AUTH_TOKEN=replace-with-strong-metrics-token
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@c2p.sn
EMAIL_REPLY_TO=support@c2p.sn
EMAIL_TIMEOUT_MS=10000
RESEND_API_KEY=replace-with-resend-api-key

# Redis
# REDIS_URL is preferred in production. Host/port remains supported.
REDIS_DISABLED=false
REDIS_URL=redis://:replace-redis-password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-redis-password
REDIS_DB=0
REDIS_TLS=false

# SendText
SMS_PROVIDER=sendtext
SMS_SENDER_ID=C2P
SMS_TEST_RECIPIENT=
SENDTEXT_BASE_URL=https://backend.sendtext.sn
SENDTEXT_SEND_PATH=/replace/with/sendtext/endpoint
SENDTEXT_API_KEY=replace-sendtext-api-key
SENDTEXT_API_SECRET=replace-sendtext-api-secret
SENDTEXT_TIMEOUT_MS=10000

# DexPay
DEXPAY_ENABLED=true
DEXPAY_BASE_URL=https://replace-with-dexpay-base-url
DEXPAY_API_KEY=replace-dexpay-api-key
DEXPAY_API_SECRET=replace-dexpay-api-secret
DEXPAY_TIMEOUT_MS=12000
DEXPAY_WEBHOOK_SECRET=replace-dexpay-webhook-secret
DEXPAY_WEBHOOK_SIGNATURE_HEADER=x-dexpay-signature
DEXPAY_DEFAULT_ASSET=DUSD
DEXPAY_DEFAULT_CHAIN=BSC
DEXPAY_ONRAMP_TYPE=BUY
DEXPAY_OFFRAMP_TYPE=SELL

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-cloudinary-key
CLOUDINARY_API_SECRET=replace-cloudinary-secret
CLOUDINARY_UPLOAD_FOLDER=c2p
