# Production template for the backend runtime.
# Keep real values only on the target host or in the CI/CD secret store.

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-db?schema=public

# Public frontend origins allowed to call the API.
# APP_ORIGINS is the canonical variable used by this project.
# CORS_ORIGIN is also accepted as a compatibility alias.
APP_ORIGINS=https://c2p.sn,https://www.c2p.sn
# CORS_ORIGIN=https://c2p.sn,https://www.c2p.sn

COOKIE_DOMAIN=.c2p.sn
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY=true
PRISMA_CONNECTION_REQUIRED=true
PRISMA_PLATFORM_SYNC_ENABLED=true
PRISMA_PLATFORM_SYNC_ON_BOOT=true
PRISMA_PLATFORM_SEED_ENABLED=false
# Garder read-only en production une fois les endpoints metier migrés.
DATA_LEGACY_API_MODE=read-only

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=15
GLOBAL_RATE_LIMIT_MAX=180
FINANCE_RATE_LIMIT_MAX=45
PROVIDER_WEBHOOK_RATE_LIMIT_MAX=180
SESSION_COOKIE_NAME=c2p_at
REFRESH_COOKIE_NAME=c2p_rt
CSRF_COOKIE_NAME=c2p_csrf

FRONTEND_MONITORING_ENABLED=true
ENABLE_METRICS=true
METRICS_AUTH_TOKEN=replace-with-strong-metrics-token
EMAIL_PROVIDER=brevo
EMAIL_FROM=no-reply@c2p.sn
EMAIL_REPLY_TO=support@c2p.sn
EMAIL_TIMEOUT_MS=10000
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_BASE_URL=https://api.brevo.com

# Compte superadmin initial / rotation d'urgence.
# Ne jamais versionner le vrai mot de passe. Utiliser C2P_SUPERADMIN_PASSWORD
# uniquement dans le secret store ou sur le VPS, puis lancer npm run auth:superadmin:set.
C2P_SUPERADMIN_EMAIL=replace-with-superadmin-email
C2P_SUPERADMIN_PASSWORD=replace-with-superadmin-password
# Alternative pour le seed initial uniquement si vous preferez fournir un hash Argon2.
C2P_SUPERADMIN_PASSWORD_HASH=

# Redis
# REDIS_URL is preferred in production. Host/port remains supported.
REDIS_DISABLED=false
REDIS_URL=redis://:replace-redis-password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-redis-password
REDIS_DB=0
REDIS_TLS=false

# SendText
SMS_PROVIDER=disabled
SMS_SENDER_ID=C2P
SMS_TEST_RECIPIENT=

# DexPay
DEXPAY_ENABLED=true
DEXPAY_BASE_URL=https://replace-with-dexpay-base-url
DEXPAY_API_KEY=replace-dexpay-api-key
DEXPAY_API_SECRET=replace-dexpay-api-secret
DEXPAY_TIMEOUT_MS=12000
DEXPAY_WEBHOOK_SECRET=replace-dexpay-webhook-secret
DEXPAY_WEBHOOK_SIGNATURE_HEADER=x-dexpay-signature
DEXPAY_DEFAULT_ASSET=DUSD
DEXPAY_DEFAULT_CHAIN=BSC
DEXPAY_ONRAMP_TYPE=BUY
DEXPAY_OFFRAMP_TYPE=SELL

# Uploads
# Production cible: Cloudflare R2 S3-compatible.
UPLOAD_STORAGE_DRIVER=s3
UPLOAD_PUBLIC_BASE_URL=https://cdn.c2p.sn
UPLOAD_STORAGE_ROOT=storage/uploads
UPLOAD_TMP_ROOT=storage/uploads/_tmp
UPLOAD_TMP_MAX_AGE_HOURS=24
UPLOAD_S3_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
UPLOAD_S3_REGION=auto
UPLOAD_S3_BUCKET=replace-with-c2p-upload-bucket
UPLOAD_S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
UPLOAD_S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
UPLOAD_S3_KEY_PREFIX=uploads
UPLOAD_S3_FORCE_PATH_STYLE=true
UPLOAD_IMAGE_MAX_MB=8
UPLOAD_RAW_MAX_MB=512
UPLOAD_VIDEO_MAX_MB=5120
UPLOAD_REQUEST_MAX_MB=5120

# Legacy media provider placeholders. Non utilises par le provider upload courant.
CLOUDINARY_CLOUD_NAME=replace-cloud-name
CLOUDINARY_API_KEY=replace-cloudinary-key
CLOUDINARY_API_SECRET=replace-cloudinary-secret
CLOUDINARY_UPLOAD_FOLDER=c2p
