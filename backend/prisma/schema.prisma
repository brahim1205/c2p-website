generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id
  email               String   @unique
  firstName           String
  lastName            String
  role                String   @default("client")
  status              String   @default("active")
  phone               String?
  avatar              String?
  bio                 String?
  location            String?
  publicTitle         String?
  website             String?
  preferredLanguage   String?
  languages           Json?
  skills              Json?
  socialLinks         Json?
  certifications      Json?
  portfolioItems      Json?
  introVideo          String?
  publicProfileEnabled Boolean @default(false)
  expertVerified      Boolean  @default(false)
  paymentSettings     Json?
  isTwoFactorEnabled  Boolean  @default(false)
  passwordHash        String?
  passwordHistory     Json?
  backupCodes         Json?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastPasswordChangeAt DateTime?
  lastLoginAt         DateTime?
  source              String   @default("native")
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([role, status])
  @@index([source])
}

model UserSessionRecord {
  id                String   @id
  userId            String
  device            String?
  location          String?
  ip                String?
  lastActive        DateTime?
  current           Boolean  @default(false)
  tokenHash         String?
  csrfToken         String?
  expiresAt         DateTime?
  absoluteExpiresAt DateTime?
  revokedAt         DateTime?
  userAgent         String?
  source            String   @default("native")
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([source])
}

model RefreshTokenSessionRecord {
  id           String   @id
  userId       String
  tokenHash    String
  sessionId    String
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  revokedAt    DateTime?
  replacedById String?
  source       String   @default("native")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([source])
}

model PendingTwoFactorChallengeRecord {
  id        String   @id
  userId    String
  codeHash  String
  purpose   String?
  expiresAt DateTime
  attempts  Int      @default(0)
  source    String   @default("native")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([source])
}

model AuditLogEntry {
  id         String   @id
  scope      String
  userId     String?
  actorLabel String?
  action     String
  targetType String?
  targetId   String?
  status     String
  ip         String?
  device     String?
  source     String   @default("native")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([scope, createdAt])
  @@index([userId, createdAt])
  @@index([source])
}

model RbacRole {
  id          String   @id
  label       String?
  description String?
  system      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([system])
}

model RbacPermission {
  id          String   @id
  label       String?
  description String?
  system      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([system])
}

model RbacRolePermission {
  id           String   @id
  roleId       String
  permissionId String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model RbacUserRole {
  id         String   @id
  userId     String
  roleId     String
  assignedBy String?
  source     String   @default("native")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([source])
}

model OutboxEvent {
  id                   String   @id
  eventType            String
  eventVersion         Int      @default(1)
  aggregateType        String?
  aggregateId          String?
  actorId              String?
  idempotencyKey       String?  @unique
  dedupeKey            String?  @unique
  status               String   @default("pending")
  attemptCount         Int      @default(0)
  retries              Int      @default(0)
  maxRetries           Int      @default(5)
  availableAt          DateTime @default(now())
  nextRetryAt          DateTime?
  occurredAt           DateTime @default(now())
  processedAt          DateTime?
  lastError            String?
  correlationId        String?
  financialOperationId String?
  payload              Json
  source               String   @default("native")
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, availableAt])
  @@index([status, nextRetryAt])
  @@index([eventType, eventVersion, status])
  @@index([aggregateType, aggregateId])
  @@index([actorId])
  @@index([correlationId])
  @@index([financialOperationId])
  @@index([occurredAt])
  @@index([source])
}

model FinancialOperation {
  id             String   @id
  kind           String
  status         String
  idempotencyKey String   @unique
  actorId        String?
  subjectUserId  String?
  resourceType   String?
  resourceId     String?
  amount         Int?
  currency       String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  @@index([kind, status])
  @@index([resourceType, resourceId])
}

model FinanceLedgerEntry {
  id                   String   @id
  financialOperationId String
  entryType            String
  accountType          String
  accountId            String?
  userId               String?
  direction            String
  amount               Int
  currency             String   @default("FCFA")
  sourceType           String?
  sourceId             String?
  transactionId        String?
  metadata             Json?
  createdAt            DateTime @default(now())

  @@index([financialOperationId])
  @@index([accountType, accountId])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model Wallet {
  id                    String   @id
  userId                String
  currency              String   @default("FCFA")
  balance               Int      @default(0)
  availableBalance      Int      @default(0)
  heldBalance           Int      @default(0)
  pendingReleaseBalance Int      @default(0)
  pendingPayoutAmount   Int      @default(0)
  source                String   @default("native")
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([source])
}

model WalletTransaction {
  id          String   @id
  userId      String?
  type        String
  amount      Int
  currency    String   @default("FCFA")
  method      String?
  status      String
  description String?
  reference   String?
  occurredAt  DateTime @default(now())
  source      String   @default("native")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type, status])
  @@index([source])
}

model SubscriptionPlan {
  id               String   @id
  role             String
  name             String
  slug             String
  priceMonthly     Int
  currency         String   @default("FCFA")
  commissionRate   Float    @default(0)
  priorityMatching Boolean  @default(false)
  analyticsLevel   String?
  supportLevel     String?
  verifiedBadge    Boolean  @default(false)
  features         Json?
  active           Boolean  @default(true)
  source           String   @default("native")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([role, active])
  @@index([source])
}

model UserSubscription {
  id             String   @id
  userId         String
  role           String
  planId         String
  planName       String
  status         String
  amount         Int
  currency       String   @default("FCFA")
  commissionRate Float    @default(0)
  autoRenew      Boolean  @default(false)
  startedAt      DateTime?
  renewsAt       DateTime?
  lastBilledAt   DateTime?
  endedAt        DateTime?
  source         String   @default("native")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
  @@index([planId])
  @@index([source])
}

model PayoutAccount {
  id                String   @id
  userId            String
  method            String
  accountName       String?
  accountIdentifier String?
  label             String?
  isDefault         Boolean  @default(false)
  source            String   @default("native")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([source])
}

model PayoutRequest {
  id          String   @id
  userId      String
  amount      Int
  currency    String   @default("FCFA")
  method      String
  accountId   String?
  status      String
  note        String?
  requestedAt DateTime?
  processedAt DateTime?
  source      String   @default("native")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([source])
}

model EscrowCase {
  id                   String   @id
  bookingId            String?
  clientId             String?
  providerId           String?
  providerUserId       String?
  requestedProviderId  String?
  service              String?
  amountTotal          Int      @default(0)
  currency             String   @default("FCFA")
  platformFeeAmount    Int      @default(0)
  providerAmount       Int      @default(0)
  status               String
  fundedAt             DateTime?
  releasedAt           DateTime?
  refundedAt           DateTime?
  note                 String?
  paymentTransactionId String?
  source               String   @default("native")
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([bookingId])
  @@index([clientId, status])
  @@index([providerUserId, status])
  @@index([source])
}

model Mission {
  id                String   @id
  clientId          String?
  providerId        String?
  requestedProviderId String?
  service           String?
  category          String?
  status            String
  requestChannel    String?
  assignmentStatus  String?
  walletFlow        String?
  scheduledAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  budgetAmount      Int?
  currency          String?
  location          String?
  description       String?
  source            String   @default("native")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([source])
}

model Invoice {
  id          String   @id
  userId      String?
  number      String?
  type        String?
  description String?
  amount      Int      @default(0)
  currency    String   @default("FCFA")
  status      String
  issueDate   DateTime?
  dueDate     DateTime?
  paidDate    DateTime?
  recipient   Json?
  items       Json?
  source      String   @default("native")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([source])
}

model NotificationDelivery {
  id                String   @id
  deliveryKey       String   @unique
  outboxEventId     String?
  eventType         String
  channel           String
  recipientUserId   String?
  recipientAddress  String?
  provider          String?
  providerMessageId String?
  status            String
  attemptedAt       DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  error             String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([outboxEventId])
  @@index([channel, status])
  @@index([recipientUserId, createdAt])
}

model WebhookDispatchRecord {
  id             String   @id
  dispatchKey    String   @unique
  outboxEventId  String?
  eventType      String
  targetUrl      String
  method         String
  status         String
  responseStatus Int?
  responseBody   String?
  error          String?
  attemptCount   Int      @default(1)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  correlationId  String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([outboxEventId])
  @@index([status, createdAt])
  @@index([correlationId])
}

model PaymentIntent {
  id                   String   @id
  actorId              String?
  userId               String?
  provider             String
  providerIntentRef    String?
  contextType          String?
  contextId            String?
  amount               Int
  currency             String   @default("FCFA")
  status               String
  expiresAt            DateTime?
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  financialOperationId String?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, status])
  @@index([provider, status])
  @@index([contextType, contextId])
  @@index([financialOperationId])
}

model ProviderTransaction {
  id                String   @id
  paymentIntentId   String?
  provider          String
  providerReference String
  providerStatus    String
  direction         String?
  amount            Int?
  currency          String?
  confirmedAt       DateTime?
  failedAt          DateTime?
  rawPayload        Json?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerReference])
  @@index([paymentIntentId])
  @@index([provider, providerStatus])
}

model WebhookReceipt {
  id             String   @id
  provider       String
  providerEventId String?
  eventType      String?
  status         String
  idempotencyKey String?
  correlationId  String?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  error          String?
  rawPayload     Json?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([provider, status])
  @@unique([provider, providerEventId])
  @@unique([provider, idempotencyKey])
  @@index([providerEventId])
  @@index([correlationId])
}

model SettlementRecord {
  id                    String   @id
  provider              String
  providerSettlementRef String?
  status                String
  amount                Int
  currency              String   @default("FCFA")
  settledAt             DateTime?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([provider, status])
  @@index([providerSettlementRef])
}

model ReconciliationJob {
  id          String   @id
  provider    String
  scope       String?
  status      String
  startedAt   DateTime?
  completedAt DateTime?
  windowStart DateTime?
  windowEnd   DateTime?
  summary     Json?
  error       String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider, status])
  @@index([windowStart, windowEnd])
}

model CommissionLedgerEntry {
  id                String   @id
  sourceType        String?
  sourceId          String?
  userId            String?
  beneficiaryUserId String?
  amount            Int      @default(0)
  currency          String   @default("FCFA")
  status            String
  description       String?
  recognizedAt      DateTime?
  source            String   @default("native")
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([beneficiaryUserId])
  @@index([source])
}

model UploadObject {
  id           String   @id @default(cuid())
  ownerId      String?
  driver       String
  storageKey   String   @unique
  relativePath String
  publicUrl    String?
  folder       String
  filename     String
  originalName String
  mimeType     String
  resourceType String
  sizeBytes    BigInt
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, status])
  @@index([driver, status])
  @@index([folder])
  @@index([resourceType])
}

model MarketplaceProvider {
  id          String   @id
  userId      String?
  name        String
  title       String?
  category    String?
  location    String?
  avatar      String?
  coverImage  String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  verified    Boolean  @default(false)
  active      Boolean  @default(true)
  services    Json?
  metadata    Json?
  source      String   @default("app_row_migration")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category, active])
  @@index([verified, active])
  @@index([source])
}

model MarketplaceProviderService {
  id             String   @id
  providerId     String
  providerUserId String?
  title          String
  description    String?
  category       String?
  location       String?
  price          Int?
  priceLabel     String?
  priceType      String?
  status         String   @default("active")
  image          String?
  metadata       Json?
  source         String   @default("app_row_migration")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([providerId, status])
  @@index([providerUserId, status])
  @@index([category, status])
  @@index([source])
}

model MarketplaceProviderReview {
  id         String   @id
  providerId String
  clientId   String?
  clientName String?
  rating     Int
  comment    String?
  service    String?
  response   String?
  helpful    Int      @default(0)
  metadata   Json?
  source     String   @default("app_row_migration")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([providerId, createdAt])
  @@index([clientId, createdAt])
  @@index([rating])
  @@index([source])
}

model MarketplaceClientFavorite {
  id         String   @id
  clientId   String
  providerId String
  metadata   Json?
  source     String   @default("app_row_migration")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, providerId])
  @@index([clientId])
  @@index([providerId])
  @@index([source])
}

model MarketplaceClientOrder {
  id          String    @id
  clientId    String
  providerId  String?
  service     String?
  status      String
  amount      Int?
  currency    String    @default("FCFA")
  scheduledAt DateTime?
  metadata    Json?
  source      String    @default("app_row_migration")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([source])
}

model MarketplaceProviderVerificationRequest {
  id             String    @id
  providerId     String
  userId         String
  requestedLevel String?
  status         String
  note           String?
  reviewedBy     String?
  requestedAt    DateTime?
  reviewedAt     DateTime?
  metadata       Json?
  source         String    @default("app_row_migration")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([providerId, status])
  @@index([userId, status])
  @@index([source])
}

model LearningCourse {
  id             String   @id
  title          String
  category       String?
  programBranch  String?
  level          String?
  description    String?
  instructorId   String?
  deliveryMode   String?
  modules        Int      @default(0)
  duration       String?
  price          Int?
  rating         Float    @default(0)
  studentsCount  Int      @default(0)
  completionRate Float    @default(0)
  revenue        Int      @default(0)
  thumbnail      String?
  status         String   @default("draft")
  metadata       Json?
  source         String   @default("app_row_migration")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, category])
  @@index([instructorId, status])
  @@index([source])
}

model LearningCourseSection {
  id           String   @id
  courseId     String
  instructorId String?
  title        String
  description  String?
  position     Int      @default(0)
  status       String   @default("draft")
  metadata     Json?
  source       String   @default("app_row_migration")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId, status, position])
  @@index([instructorId, status])
  @@index([source])
}

model LearningCourseLesson {
  id           String   @id
  courseId     String
  sectionId    String?
  instructorId String?
  title        String
  description  String?
  lessonType   String?
  position     Int      @default(0)
  duration     String?
  isPreview    Boolean  @default(false)
  status       String   @default("draft")
  metadata     Json?
  source       String   @default("app_row_migration")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId, status, position])
  @@index([sectionId, status, position])
  @@index([instructorId, status])
  @@index([source])
}

model LearningCourseReview {
  id            String   @id
  courseId      String
  studentId     String?
  studentName   String?
  studentAvatar String?
  rating        Int      @default(0)
  comment       String?
  status        String   @default("published")
  metadata      Json?
  source        String   @default("app_row_migration")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId, status, createdAt])
  @@index([studentId, createdAt])
  @@index([source])
}

model LearningVirtualClass {
  id               String    @id
  courseId         String
  title            String
  courseName       String?
  classDate        String?
  classTime        String?
  duration         String?
  studentsCount    Int       @default(0)
  maxStudents      Int?
  provider         String?
  meetingSlug      String?
  recordingEnabled Boolean   @default(false)
  recordingStatus  String?
  status           String    @default("scheduled")
  recordingUrl     String?
  roomLink         String?
  startedAt        DateTime?
  endedAt          DateTime?
  metadata         Json?
  source           String    @default("app_row_migration")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([courseId, status])
  @@index([classDate, classTime])
  @@index([source])
}

model LearningCourseEnrollment {
  id                  String    @id
  courseId            String
  courseName          String?
  courseCategory      String?
  courseLessonsCount  Int       @default(0)
  studentId           String
  studentName         String?
  studentEmail        String?
  studentAvatar       String?
  progress            Float     @default(0)
  grade               Float?
  status              String    @default("active")
  lastActiveAt        DateTime?
  enrolledAt          DateTime?
  metadata            Json?
  source              String    @default("app_row_migration")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([studentId, status])
  @@index([courseId, status])
  @@index([source])
}

model LearningLessonProgress {
  id                   String    @id
  courseId             String
  sectionId            String?
  lessonId             String
  studentId            String
  studentName          String?
  progress             Float     @default(0)
  completed            Boolean   @default(false)
  bookmarked           Boolean   @default(false)
  note                 String?
  videoPositionSeconds Int       @default(0)
  status               String    @default("in_progress")
  firstViewedAt        DateTime?
  lastViewedAt         DateTime?
  completedAt          DateTime?
  metadata             Json?
  source               String    @default("app_row_migration")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([studentId, courseId])
  @@index([lessonId, studentId])
  @@index([courseId, status])
  @@index([source])
}

model LearningExam {
  id           String    @id
  courseId     String
  courseName   String?
  instructorId String?
  title        String
  examType     String    @default("quiz")
  examDate     DateTime?
  participants Int       @default(0)
  submitted    Int       @default(0)
  avgGrade     Float?
  status       String    @default("upcoming")
  maxGrade     Float     @default(20)
  instructions String?
  attachments  Json?
  metadata     Json?
  source       String    @default("app_row_migration")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([courseId, status])
  @@index([instructorId, status])
  @@index([source])
}

model LearningQuizQuestion {
  id           String   @id
  examId       String
  courseId     String?
  instructorId String?
  prompt       String
  questionType String   @default("single_choice")
  points       Int      @default(1)
  explanation  String?
  required     Boolean  @default(true)
  position     Int      @default(0)
  metadata     Json?
  source       String   @default("app_row_migration")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([examId, position])
  @@index([courseId])
  @@index([source])
}

model LearningQuizChoice {
  id           String   @id
  questionId   String
  examId       String
  courseId     String?
  instructorId String?
  label        String
  value        String?
  isCorrect    Boolean  @default(false)
  position     Int      @default(0)
  metadata     Json?
  source       String   @default("app_row_migration")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([questionId, position])
  @@index([examId, position])
  @@index([source])
}

model LearningSubmission {
  id            String    @id
  examId        String
  courseId      String?
  studentId     String
  studentName   String?
  studentAvatar String?
  submittedAt   DateTime?
  grade         Float?
  feedback      String?
  status        String    @default("pending")
  fileName      String?
  fileUrl       String?
  answers       Json?
  gradedAt      DateTime?
  metadata      Json?
  source        String    @default("app_row_migration")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([examId, status])
  @@index([studentId, submittedAt])
  @@index([source])
}

model LearningCertificate {
  id                String    @id
  studentId         String
  studentName       String?
  studentAvatar     String?
  courseId          String
  courseName        String?
  title             String?
  completionDate    DateTime?
  finalGrade        Float?
  grade             Float?
  status            String    @default("pending")
  certificateId     String?
  certificateNumber String?
  issuedAt          DateTime?
  metadata          Json?
  source            String    @default("app_row_migration")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studentId, status])
  @@index([courseId, status])
  @@index([source])
}

model ProjectCenterProject {
  id            String   @id
  ownerId       String?
  title         String
  description   String?
  category      String?
  sector        String?
  status        String   @default("draft")
  phase         String?
  porteurName   String?
  funding       Int      @default(0)
  fundingGoal   Int      @default(0)
  teamSize      Int      @default(0)
  progress      Float    @default(0)
  location      String?
  impact        String?
  image         String?
  lookingFor    Json?
  nextMilestone String?
  metadata      Json?
  source        String   @default("app_row_migration")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, category])
  @@index([ownerId, status])
  @@index([source])
}

model ProjectCenterMilestone {
  id          String   @id
  projectId   String
  title       String
  description String?
  dueDate     String?
  status      String   @default("pending")
  progress    Float    @default(0)
  tasks       Json?
  metadata    Json?
  source      String   @default("app_row_migration")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([source])
}

model ProjectCenterDocument {
  id        String   @id
  projectId String
  name      String
  docType   String?
  size      String?
  docDate   String?
  category  String?
  url       String?
  metadata  Json?
  source    String   @default("app_row_migration")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, category])
  @@index([projectId, docDate])
  @@index([source])
}

model AppRow {
  key       String   @id
  table     String
  rowId     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([table, rowId])
  @@index([table])
}
