NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://app_user:replace-me@db-host:5432/app_db?schema=public
APP_ORIGINS=https://c2p.sn,https://www.c2p.sn
# CORS_ORIGIN=https://c2p.sn,https://www.c2p.sn
COOKIE_DOMAIN=.c2p.sn
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY=true
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
GLOBAL_RATE_LIMIT_MAX=180
SESSION_COOKIE_NAME=c2p_at
REFRESH_COOKIE_NAME=c2p_rt
CSRF_COOKIE_NAME=c2p_csrf
FRONTEND_MONITORING_ENABLED=true
ENABLE_METRICS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DISABLED=false
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_DB=0
REDIS_TLS=false
SMS_PROVIDER=sendtext
SMS_SENDER_ID=C2P
SMS_TEST_RECIPIENT=
SENDTEXT_BASE_URL=https://backend.sendtext.sn
SENDTEXT_SEND_PATH=/replace/with/sendtext/endpoint
SENDTEXT_API_KEY=replace-with-sendtext-api-key
SENDTEXT_API_SECRET=replace-with-sendtext-api-secret
SENDTEXT_TIMEOUT_MS=10000
DEXPAY_ENABLED=true
DEXPAY_BASE_URL=https://replace-with-dexpay-base-url
DEXPAY_API_KEY=replace-with-dexpay-api-key
DEXPAY_API_SECRET=replace-with-dexpay-api-secret
DEXPAY_TIMEOUT_MS=12000
DEXPAY_DEFAULT_ASSET=DUSD
DEXPAY_DEFAULT_CHAIN=BSC
DEXPAY_ONRAMP_TYPE=BUY
DEXPAY_OFFRAMP_TYPE=SELL
