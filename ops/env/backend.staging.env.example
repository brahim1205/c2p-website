NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://c2p_staging:replace-with-strong-staging-postgres-password@postgres:5432/c2p_staging?schema=public&connection_limit=10&pool_timeout=10
APP_ORIGINS=https://staging.c2p.sn
# CORS_ORIGIN=https://staging.c2p.sn
COOKIE_DOMAIN=staging.c2p.sn
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY=true
PRISMA_CONNECTION_REQUIRED=true
PRISMA_PLATFORM_SYNC_ENABLED=true
PRISMA_PLATFORM_SYNC_ON_BOOT=true
PRISMA_PLATFORM_SEED_ENABLED=false
DATA_LEGACY_API_MODE=read-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=90
GLOBAL_RATE_LIMIT_MAX=1200
FINANCE_RATE_LIMIT_MAX=120
PROVIDER_WEBHOOK_RATE_LIMIT_MAX=300
SESSION_COOKIE_NAME=c2p_staging_at
REFRESH_COOKIE_NAME=c2p_staging_rt
CSRF_COOKIE_NAME=c2p_staging_csrf
FRONTEND_MONITORING_ENABLED=true
ENABLE_METRICS=true
METRICS_AUTH_TOKEN=replace-with-strong-staging-metrics-token
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@staging.c2p.sn
EMAIL_REPLY_TO=support@c2p.sn
EMAIL_TIMEOUT_MS=10000
RESEND_API_KEY=replace-with-resend-api-key
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_BASE_URL=https://api.brevo.com
OAUTH_CALLBACK_BASE_URL=https://staging.c2p.sn/api
OAUTH_STATE_SECRET=replace-with-strong-staging-oauth-state-secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DISABLED=false
REDIS_URL=redis://:replace-with-strong-staging-redis-password@redis:6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-strong-staging-redis-password
REDIS_DB=0
REDIS_TLS=false
SMS_PROVIDER=brevo
SMS_SENDER_ID=C2P
SMS_TEST_RECIPIENT=
DEXPAY_ENABLED=false
DEXPAY_BASE_URL=https://replace-with-dexpay-staging-base-url
DEXPAY_API_KEY=replace-with-dexpay-staging-api-key
DEXPAY_API_SECRET=replace-with-dexpay-staging-api-secret
DEXPAY_TIMEOUT_MS=12000
DEXPAY_WEBHOOK_SECRET=replace-with-dexpay-staging-webhook-secret
DEXPAY_WEBHOOK_SIGNATURE_HEADER=x-dexpay-signature
DEXPAY_DEFAULT_ASSET=DUSD
DEXPAY_DEFAULT_CHAIN=BSC
DEXPAY_ONRAMP_TYPE=BUY
DEXPAY_OFFRAMP_TYPE=SELL
UPLOAD_STORAGE_DRIVER=s3
UPLOAD_PUBLIC_BASE_URL=https://staging-cdn.c2p.sn
UPLOAD_STORAGE_ROOT=storage/uploads
UPLOAD_TMP_ROOT=storage/uploads/_tmp
UPLOAD_TMP_MAX_AGE_HOURS=24
UPLOAD_S3_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
UPLOAD_S3_REGION=auto
UPLOAD_S3_BUCKET=replace-with-c2p-staging-upload-bucket
UPLOAD_S3_ACCESS_KEY_ID=replace-with-r2-staging-access-key-id
UPLOAD_S3_SECRET_ACCESS_KEY=replace-with-r2-staging-secret-access-key
UPLOAD_S3_KEY_PREFIX=uploads/staging
UPLOAD_S3_FORCE_PATH_STYLE=true
UPLOAD_IMAGE_MAX_MB=8
UPLOAD_RAW_MAX_MB=512
UPLOAD_VIDEO_MAX_MB=5120
UPLOAD_REQUEST_MAX_MB=5120
