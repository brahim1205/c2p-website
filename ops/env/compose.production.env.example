BACKEND_ENV_FILE=./ops/env/backend.production.env
POSTGRES_DB=c2p
POSTGRES_USER=c2p
POSTGRES_PASSWORD=replace-with-strong-postgres-password
REDIS_PASSWORD=replace-with-strong-redis-password
BACKEND_DNS_PRIMARY=153.92.2.6
BACKEND_DNS_SECONDARY=1.1.1.1
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-strong-grafana-password
GF_SERVER_ROOT_URL=http://127.0.0.1:3004
SONAR_POSTGRES_DB=sonarqube
SONAR_POSTGRES_USER=sonarqube
SONAR_POSTGRES_PASSWORD=replace-with-strong-sonarqube-postgres-password
SONAR_WEB_JAVAOPTS="-Xms128m -Xmx512m"
SONAR_CE_JAVAOPTS="-Xms128m -Xmx512m"
SONAR_SEARCH_JAVAOPTS="-Xms512m -Xmx512m"
BACKUP_RETENTION_DAYS=14
BACKUP_CRON_SCHEDULE="30 2 * * *"
