{
  "name": "react",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:test": "node scripts/smoke.mjs",
    "smoke:test:local": "FRONT_URL=http://localhost:3000 API_URL=http://localhost:3003/api node scripts/smoke.mjs",
    "smoke:test:client": "FRONT_URL=${FRONT_URL:-http://localhost:3000} API_URL=${API_URL:-http://localhost:3003/api} C2P_SMOKE_SUITES=client node scripts/smoke.mjs",
    "smoke:test:forms": "node scripts/form-coherence.mjs",
    "smoke:test:forms:local": "FRONT_URL=http://localhost:3000 API_URL=http://localhost:3003/api node scripts/form-coherence.mjs",
    "smoke:test:release": "npm run smoke:test && npm run smoke:test:forms",
    "architecture:check": "node ../ops/scripts/architecture-check.mjs",
    "large-file:ratchet": "node ../ops/scripts/large-file-ratchet-check.mjs",
    "state:check": "node scripts/state-boundary-check.mjs",
    "design:check": "node scripts/design-guard.mjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit --project tsconfig.app.json",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "verify": "npm run architecture:check && npm run large-file:ratchet && npm run state:check && npm run design:check && npm run type-check && npm run lint && npm run build && npm run bundle:budget"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "4.0.2",
    "@tanstack/react-query": "^5.106.1",
    "@types/qrcode": "^1.5.6",
    "gsap": "^3.15.1",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "3.10.1",
    "remixicon": "^4.6.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.6.1",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "source-map": "^0.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^7.0.3"
  },
  "overrides": {
    "protobufjs": "8.8.0",
    "websocket-driver": "0.7.5"
  }
}
